# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored, so credentials are never committed.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=your_database_name

# Auth: use a long random string, e.g. run:  openssl rand -base64 32
JWT_SECRET=change_me_to_a_long_random_string

# Neo4j (used in the next step)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
